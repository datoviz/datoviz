    {
      "cmd": "CreateShaderModule",
      "id": 15,
      "stage": "VERTEX",
      "format": "wgsl",
      "entry_point": "main",
      "code": "struct MVP {\n    model: mat4x4f,\n    view: mat4x4f,\n    proj: mat4x4f,\n    time: f32,\n    flags: u32,\n}\n\nstruct Viewport {\n    rect: vec4f,\n}\n\nstruct VertexIn {\n    @location(0) position: vec3f,\n    @location(1) color: vec4f,\n}\n\nstruct VertexOut {\n    @builtin(position) position: vec4f,\n    @location(0) color: vec4f,\n}\n\n@group(0) @binding(0) var<uniform> mvp: MVP;\n@group(0) @binding(1) var<uniform> viewport: Viewport;\n\nfn transform(position: vec3f) -> vec4f {\n    return mvp.proj * mvp.view * mvp.model * vec4f(position, 1.0);\n}\n\n@vertex\nfn main(input: VertexIn) -> VertexOut {\n    var output: VertexOut;\n    output.position = transform(input.position);\n    output.color = input.color;\n    return output;\n}\n",
      "builtin_family": "scene.primitive",
      "builtin_variant": "default",
      "builtin_version": 1
    },
