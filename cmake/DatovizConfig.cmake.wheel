cmake_minimum_required(VERSION 3.21)

get_filename_component(_dvz_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(NOT TARGET datoviz::datoviz)
    add_library(datoviz::datoviz SHARED IMPORTED)

    if(WIN32)
        set(_dvz_lib "${_dvz_root}/datoviz.dll")
        if(NOT EXISTS "${_dvz_lib}")
            set(_dvz_lib "${_dvz_root}/libdatoviz.dll")
        endif()
        set(_dvz_implib "${_dvz_root}/datoviz.lib")
        if(NOT EXISTS "${_dvz_implib}")
            set(_dvz_implib "${_dvz_root}/libdatoviz.dll.a")
        endif()
    elseif(APPLE)
        set(_dvz_lib "${_dvz_root}/libdatoviz.dylib")
    else()
        set(_dvz_lib "${_dvz_root}/libdatoviz.so")
    endif()

    if(NOT EXISTS "${_dvz_lib}")
        message(FATAL_ERROR "Datoviz shared library not found in wheel package: ${_dvz_lib}")
    endif()

    set_target_properties(datoviz::datoviz PROPERTIES
        IMPORTED_LOCATION "${_dvz_lib}"
        INTERFACE_INCLUDE_DIRECTORIES "${_dvz_root}/include"
    )

    if(WIN32 AND EXISTS "${_dvz_implib}")
        set_target_properties(datoviz::datoviz PROPERTIES IMPORTED_IMPLIB "${_dvz_implib}")
    endif()

    if(APPLE OR UNIX)
        set_target_properties(datoviz::datoviz PROPERTIES
            INTERFACE_LINK_OPTIONS "-Wl,-rpath,${_dvz_root}"
        )
    endif()
endif()
