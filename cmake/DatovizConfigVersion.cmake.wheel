# CMake accepts numeric package versions only.
# Release candidates use their PEP 440 release segment.
set(PACKAGE_VERSION "@DVZ_WHEEL_CMAKE_VERSION@")
set(DVZ_PACKAGE_VERSION_HAS_SUFFIX @DVZ_WHEEL_VERSION_HAS_SUFFIX@)

if(PACKAGE_FIND_VERSION)
    if(DVZ_PACKAGE_VERSION_HAS_SUFFIX AND PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT FALSE)
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    elseif(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
        if(NOT DVZ_PACKAGE_VERSION_HAS_SUFFIX AND PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
            set(PACKAGE_VERSION_EXACT TRUE)
        endif()
    endif()
endif()
