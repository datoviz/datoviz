_DVZ_UNAME="$(uname)"

if [[ "${_DVZ_UNAME}" == "Darwin" ]]; then
    # Configure Vulkan SDK environment for Datoviz.
    if [ -f "./tools/vulkan-env.sh" ]; then
        source ./tools/vulkan-env.sh
    fi
    # Avoid stale shell values overriding the SDK ICD selected in tools/vulkan-env.sh.
    unset VK_DRIVER_FILES
    unset VK_ROOT
    # Prefer DYLD_FALLBACK_LIBRARY_PATH for Vulkan loader resolution.
    # In this repo, setting DYLD_LIBRARY_PATH causes Volk to fall back to libMoltenVK directly,
    # which hides SDK validation layers.
    unset DYLD_LIBRARY_PATH
elif [[ "${_DVZ_UNAME}" == "Linux" ]]; then
    export VK_LAYER_SETTINGS_PATH="${HOME}/.vulkan_layers"
    # Configure Vulkan SDK environment for Datoviz.
    if [ -f "./tools/vulkan-env.sh" ]; then
        source ./tools/vulkan-env.sh
    fi
fi

unset _DVZ_UNAME
