_DVZ_UNAME="$(uname)"

if [[ "${_DVZ_UNAME}" == "Darwin" ]]; then
    # Configure Vulkan SDK environment for Datoviz.
    if [ -f "./tools/vulkan-env.sh" ]; then
        source ./tools/vulkan-env.sh
    fi

    # Ensure repo-local Vulkan loader and MoltenVK ICD are used across all commands.
    _DVZ_ARCH="$(arch)"
    if [ "${_DVZ_ARCH}" = "aarch64" ] || [ "${_DVZ_ARCH}" = "arm64" ]; then
        _DVZ_VK_ARCH="arm64"
    else
        _DVZ_VK_ARCH="x86_64"
    fi
    _DVZ_VK_ROOT="${PWD}/libs/vulkan/macos_${_DVZ_VK_ARCH}"
    if [ -f "${_DVZ_VK_ROOT}/MoltenVK_icd.json" ]; then
        export VK_ROOT="${_DVZ_VK_ROOT}"
        export VK_DRIVER_FILES="${_DVZ_VK_ROOT}/MoltenVK_icd.json"
        export VK_ICD_FILENAMES="${_DVZ_VK_ROOT}/MoltenVK_icd.json"
        if [ -n "${DYLD_LIBRARY_PATH:-}" ]; then
            case ":${DYLD_LIBRARY_PATH}:" in
                *:"${_DVZ_VK_ROOT}":*) ;;
                *) export DYLD_LIBRARY_PATH="${_DVZ_VK_ROOT}:${DYLD_LIBRARY_PATH}" ;;
            esac
        else
            export DYLD_LIBRARY_PATH="${_DVZ_VK_ROOT}"
        fi
    fi
elif [[ "${_DVZ_UNAME}" == "Linux" ]]; then
    export VK_LAYER_SETTINGS_PATH="${HOME}/.vulkan_layers"
    # Configure Vulkan SDK environment for Datoviz.
    if [ -f "./tools/vulkan-env.sh" ]; then
        source ./tools/vulkan-env.sh
    fi
fi

unset _DVZ_VK_ROOT
unset _DVZ_VK_ARCH
unset _DVZ_ARCH
unset _DVZ_UNAME
