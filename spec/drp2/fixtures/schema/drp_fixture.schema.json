{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drp_fixture.schema.json",
  "title": "DRP2Fixture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "fix": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "patch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_buffer_size": {
          "type": "integer",
          "minimum": 0
        },
        "max_texture_dimension_1d": {
          "type": "integer",
          "minimum": 1
        },
        "max_texture_dimension_2d": {
          "type": "integer",
          "minimum": 1
        },
        "max_texture_dimension_3d": {
          "type": "integer",
          "minimum": 1
        },
        "supported_texture_formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_sample_counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "schema_validation",
            "semantic_validation",
            "capability_validation"
          ]
        },
        "code": {
          "type": "string"
        },
        "command_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "outcome"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "error"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "phase",
              "code"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expected": {
            "properties": {
              "phase": {
                "const": "schema_validation"
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        "required": [
          "expected"
        ]
      },
      "then": {
        "properties": {
          "commands": {
            "items": {
              "type": "object"
            }
          }
        }
      },
      "else": {
        "allOf": [
          {
            "properties": {
              "commands": {
                "items": {
                  "$ref": "../../schema/drp_command.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "expected": {
                  "properties": {
                    "outcome": {
                      "const": "success"
                    }
                  },
                  "required": [
                    "outcome"
                  ]
                }
              },
              "required": [
                "expected"
              ]
            },
            "then": {
              "properties": {
                "commands": {
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "cmd": {
                          "const": "HelloRenderer"
                        }
                      },
                      "required": [
                        "cmd"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "cmd": {
                          "const": "RendererHelloReply"
                        }
                      },
                      "required": [
                        "cmd"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "required": [
    "name",
    "version",
    "commands",
    "expected"
  ]
}
