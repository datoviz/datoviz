{
  "name": "pressure_texture_sample",
  "description": "Upload a 2x2 rgba8unorm texture, bind it with a sampler, and read it in a fragment shader using textureSample.",
  "reason": "The source texture is live and has TEXTURE_BINDING usage. A sampler object is created and bound alongside it. The fragment shader reads a texel using textureSample with linear filtering. The full path from texture upload to render-submit is valid under the active DRP2 2.0 contract.",
  "notes": "Pressure test #3 from LAYER1.md. This fixture uses textureSample with an explicit sampler object. The bind-group layout declares two entries: binding 0 for the sampled_texture and binding 1 for the sampler. The vertex shader uses @builtin(vertex_index) to generate a fullscreen triangle without a vertex buffer, so vertex_buffer_slots is 0.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "pressure_test",
    "texture_sampling",
    "sampler",
    "render_pass",
    "pipeline",
    "bind_group",
    "upload",
    "draw",
    "queue"
  ],
  "capabilities": {
    "max_buffer_size": 134217728,
    "max_texture_dimension_1d": 8192,
    "max_texture_dimension_2d": 8192,
    "max_texture_dimension_3d": 2048,
    "supported_texture_formats": ["rgba8unorm"],
    "supported_sample_counts": [1],
    "supported_shader_formats": ["wgsl"],
    "supports_fp64": false
  },
  "commands": [
    {
      "cmd": "HelloRenderer",
      "version": { "major": 2, "minor": 0 },
      "client_name": "fixture-client"
    },
    {
      "cmd": "RendererHelloReply",
      "version": { "major": 2, "minor": 0 },
      "status": "ok",
      "renderer_name": "fixture-renderer"
    },
    {
      "cmd": "CreateSampler",
      "id": 200,
      "label": "linear_sampler",
      "mag_filter": "linear",
      "min_filter": "linear",
      "mipmap_filter": "nearest",
      "address_mode_u": "clamp-to-edge",
      "address_mode_v": "clamp-to-edge"
    },
    {
      "cmd": "CreateBindGroupLayout",
      "id": 100,
      "label": "texture_and_sampler_bindings",
      "entries": [
        { "binding": 0, "binding_type": "sampled_texture", "visibility": ["FRAGMENT"] },
        { "binding": 1, "binding_type": "sampler", "visibility": ["FRAGMENT"] }
      ]
    },
    {
      "cmd": "CreateShaderModule",
      "id": 9000,
      "stage": "VERTEX",
      "format": "wgsl",
      "entry_point": "main",
      "code": "@vertex fn main(@builtin(vertex_index) idx: u32) -> @builtin(position) vec4f { var pos = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0)); return vec4f(pos[idx], 0.0, 1.0); }"
    },
    {
      "cmd": "CreateShaderModule",
      "id": 9001,
      "stage": "FRAGMENT",
      "format": "wgsl",
      "entry_point": "main",
      "code": "@group(0) @binding(0) var source: texture_2d<f32>; @group(0) @binding(1) var samp: sampler; @fragment fn main(@builtin(position) pos: vec4f) -> @location(0) vec4f { return textureSample(source, samp, vec2f(0.5, 0.5)); }"
    },
    {
      "cmd": "CreateRenderPipeline",
      "id": 10,
      "label": "blit_pipeline",
      "vertex_shader_module_id": 9000,
      "fragment_shader_module_id": 9001,
      "vertex_buffer_slots": 0,
      "bind_group_layout_ids": [100]
    },
    {
      "cmd": "CreateTexture",
      "id": 2,
      "label": "source_texture",
      "dimension": "2d",
      "width": 2,
      "height": 2,
      "depth": 1,
      "format": "rgba8unorm",
      "usage": ["TEXTURE_BINDING", "COPY_DST"],
      "mip_level_count": 1,
      "sample_count": 1
    },
    {
      "cmd": "WriteTexture",
      "texture_id": 2,
      "mip_level": 0,
      "origin": { "x": 0, "y": 0, "z": 0 },
      "size": { "width": 2, "height": 2, "depth": 1 },
      "bytes_per_row": 8,
      "rows_per_image": 2,
      "data": "AAAAAAAAAAAAAAAAAAAAAA=="
    },
    {
      "cmd": "CreateBindGroup",
      "id": 13,
      "label": "texture_and_sampler_bind_group",
      "bind_group_layout_id": 100,
      "entries": [
        {
          "binding": 0,
          "binding_type": "sampled_texture",
          "resource_kind": "texture",
          "resource_id": 2
        },
        {
          "binding": 1,
          "binding_type": "sampler",
          "resource_kind": "sampler",
          "resource_id": 200
        }
      ]
    },
    {
      "cmd": "CreateTexture",
      "id": 1,
      "label": "render_target",
      "dimension": "2d",
      "width": 4,
      "height": 4,
      "depth": 1,
      "format": "rgba8unorm",
      "usage": ["RENDER_ATTACHMENT"],
      "mip_level_count": 1,
      "sample_count": 1
    },
    {
      "cmd": "BeginCommandEncoder",
      "id": 20
    },
    {
      "cmd": "BeginRenderPass",
      "id": 21,
      "encoder_id": 20,
      "color_attachments": [
        {
          "texture_id": 1,
          "load_op": "clear",
          "store_op": "store",
          "clear_value": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 1.0 }
        }
      ]
    },
    {
      "cmd": "SetPipeline",
      "pass_id": 21,
      "pipeline_id": 10
    },
    {
      "cmd": "SetBindGroup",
      "pass_id": 21,
      "slot": 0,
      "bind_group_id": 13
    },
    {
      "cmd": "Draw",
      "pass_id": 21,
      "vertex_count": 3,
      "instance_count": 1,
      "first_vertex": 0,
      "first_instance": 0
    },
    {
      "cmd": "EndRenderPass",
      "pass_id": 21
    },
    {
      "cmd": "FinishCommandEncoder",
      "encoder_id": 20,
      "command_buffer_id": 22
    },
    {
      "cmd": "QueueSubmit",
      "command_buffer_ids": [22],
      "submission_id": 30
    }
  ],
  "expected": {
    "outcome": "success"
  }
}
