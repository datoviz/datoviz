{
  "name": "shader_module_create_basic",
  "description": "Creates one WGSL shader module after a successful handshake.",
  "reason": "Shader modules are active persistent objects in DRP2 2.0 and may be created outside encoder or pass scope.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "shader"
  ],
  "commands": [
    {
      "cmd": "HelloRenderer",
      "version": {
        "major": 2,
        "minor": 0
      },
      "client_name": "fixture-client"
    },
    {
      "cmd": "RendererHelloReply",
      "version": {
        "major": 2,
        "minor": 0
      },
      "status": "ok",
      "renderer_name": "fixture-renderer"
    },
    {
      "cmd": "CreateShaderModule",
      "id": 10,
      "stage": "COMPUTE",
      "format": "wgsl",
      "entry_point": "main",
      "code": "@compute @workgroup_size(1) fn main() {}"
    }
  ],
  "expected": {
    "outcome": "success"
  }
}
