{
  "name": "copy_buffer_to_texture_basic",
  "description": "Copies a small region from a source buffer into a destination texture.",
  "reason": "The encoder is open, no pass is active, the source and destination usages are compatible, and the copied region fits both resources.",
  "notes": "This fixture exercises the happy-path shape of CopyBufferToTexture without involving render-pass state.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "copy",
    "texture"
  ],
  "commands": [
    {
      "cmd": "CreateBuffer",
      "id": 1,
      "size": 16,
      "usage": [
        "COPY_SRC"
      ]
    },
    {
      "cmd": "CreateTexture",
      "id": 2,
      "dimension": "2d",
      "width": 2,
      "height": 2,
      "depth": 1,
      "format": "rgba8unorm",
      "usage": [
        "COPY_DST"
      ],
      "mip_level_count": 1,
      "sample_count": 1
    },
    {
      "cmd": "BeginCommandEncoder",
      "id": 3
    },
    {
      "cmd": "CopyBufferToTexture",
      "encoder_id": 3,
      "src_buffer_id": 1,
      "src_offset": 0,
      "bytes_per_row": 8,
      "rows_per_image": 1,
      "dst_texture_id": 2,
      "dst_mip_level": 0,
      "dst_origin": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "size": {
        "width": 2,
        "height": 1,
        "depth": 1
      }
    }
  ],
  "expected": {
    "outcome": "success"
  }
}
