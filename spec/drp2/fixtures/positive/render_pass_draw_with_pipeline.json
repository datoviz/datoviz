            "r": 0,
            "g": 0,
            "b": 0,
            "a": 1
          }
        }
      ]
    },
    {
      "cmd": "SetPipeline",
      "pass_id": 3,
      "pipeline_id": 10
    },
    {
      "cmd": "SetVertexBuffer",
      "pass_id": 3,
      "slot": 0,
      "buffer_id": 11,
      "offset": 0
    },
    {
      "cmd": "Draw",
      "pass_id": 3,
      "vertex_count": 3,
      "instance_count": 1,
      "first_vertex": 0,
      "first_instance": 0
    },
    {
      "cmd": "EndRenderPass",
      "pass_id": 3
    },
    {
      "cmd": "FinishCommandEncoder",
      "encoder_id": 2,
      "command_buffer_id": 4
