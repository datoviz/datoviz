{
  "name": "render_pass_draw_with_pipeline",
  "description": "Begins a render pass, binds a pipeline, records one draw, ends the pass, and finishes the encoder.",
  "reason": "A live render pipeline is created and bound before Draw, and the required vertex buffer slot is bound in the same render pass.",
  "notes": "This fixture exercises the active render-pipeline and vertex-buffer binding contract without introducing deferred shader-module or layout objects.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "render_pass",
    "pipeline",
    "draw"
  ],
  "commands": [
    {
      "cmd": "CreateRenderPipeline",
      "id": 10,
      "vertex_buffer_slots": 1
    },
    {
      "cmd": "CreateBuffer",
      "id": 11,
      "size": 64,
      "usage": [
        "VERTEX"
      ]
    },
    {
      "cmd": "CreateTexture",
      "id": 1,
      "dimension": "2d",
      "width": 4,
      "height": 4,
      "depth": 1,
      "format": "rgba8unorm",
      "usage": [
        "RENDER_ATTACHMENT"
      ],
      "mip_level_count": 1,
      "sample_count": 1
    },
    {
      "cmd": "BeginCommandEncoder",
      "id": 2
    },
    {
      "cmd": "BeginRenderPass",
      "id": 3,
