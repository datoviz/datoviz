{
  "name": "pressure_dynamic_buffer_update",
  "description": "Upload vertex and uniform data, submit a render frame, write updated data to the same buffers, then submit a second render frame.",
  "reason": "WriteBuffer on a live buffer is valid after QueueSubmit. The same vertex buffer and uniform buffer are reused across two submission cycles with new content written between them. Both submissions reference the same pipeline and bind group. The runtime is responsible for any backend-level synchronization between submissions.",
  "notes": "Pressure test #2 from LAYER1.md. This fixture demonstrates the standard per-frame dynamic update pattern: static pipeline and binding objects are created once and reused, while mutable resource contents are re-uploaded before each submission. DRP2 2.0 has no explicit fence or completion primitive, so the producer treats resources as available for re-upload once a new command buffer is being built for the next frame. The runtime handles the necessary synchronization at the backend level.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "pressure_test",
    "dynamic_update",
    "render_pass",
    "pipeline",
    "bind_group",
    "upload",
    "draw",
    "queue"
  ],
  "capabilities": {
    "max_buffer_size": 134217728,
    "max_texture_dimension_1d": 8192,
    "max_texture_dimension_2d": 8192,
    "max_texture_dimension_3d": 2048,
    "supported_texture_formats": ["rgba8unorm"],
    "supported_sample_counts": [1],
    "supported_shader_formats": ["wgsl"],
    "supports_fp64": false
  },
