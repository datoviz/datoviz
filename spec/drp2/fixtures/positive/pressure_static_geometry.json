{
  "name": "pressure_static_geometry",
  "description": "Upload static vertex geometry and a uniform color, then render a triangle into a render target and submit.",
  "reason": "Static geometry is pre-uploaded via WriteBuffer before encoding begins. The render pipeline reads from a vertex buffer and a uniform bind group. A complete render-submit cycle finishes the stream. This is the minimal DRP2 expression of a static-geometry panel.",
  "notes": "Pressure test #1 from LAYER1.md. The vertex buffer carries three float-3 vertices (36 bytes). The uniform buffer carries a vec4f panel color (16 bytes). Both are written before the encoder opens, which is the normal producer pattern for geometry that does not change between submissions. This fixture validates the full path: resource upload → pipeline creation → render pass → queue submit.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "pressure_test",
    "static_geometry",
    "render_pass",
    "pipeline",
    "bind_group",
    "upload",
    "draw",
    "queue"
  ],
  "capabilities": {
    "max_buffer_size": 134217728,
    "max_texture_dimension_1d": 8192,
    "max_texture_dimension_2d": 8192,
    "max_texture_dimension_3d": 2048,
    "supported_texture_formats": ["rgba8unorm"],
    "supported_sample_counts": [1],
    "supported_shader_formats": ["wgsl"],
    "supports_fp64": false
  },
  "commands": [
    {
      "cmd": "HelloRenderer",
      "version": { "major": 2, "minor": 0 },
      "client_name": "fixture-client"
    },
    {
      "cmd": "RendererHelloReply",
      "version": { "major": 2, "minor": 0 },
      "status": "ok",
      "renderer_name": "fixture-renderer"
    },
    {
      "cmd": "CreateBindGroupLayout",
      "id": 100,
      "label": "panel_uniforms",
      "entries": [
        { "binding": 0, "binding_type": "uniform_buffer", "visibility": ["FRAGMENT"] }
      ]
    },
    {
      "cmd": "CreateShaderModule",
      "id": 9000,
      "stage": "VERTEX",
      "format": "wgsl",
      "entry_point": "main",
      "code": "@vertex fn main(@location(0) position: vec3f) -> @builtin(position) vec4f { return vec4f(position, 1.0); }"
    },
    {
      "cmd": "CreateShaderModule",
      "id": 9001,
      "stage": "FRAGMENT",
      "format": "wgsl",
      "entry_point": "main",
      "code": "@group(0) @binding(0) var<uniform> color: vec4f; @fragment fn main() -> @location(0) vec4f { return color; }"
    },
    {
      "cmd": "CreateRenderPipeline",
      "id": 10,
      "label": "triangle_pipeline",
      "vertex_shader_module_id": 9000,
      "fragment_shader_module_id": 9001,
      "vertex_buffer_slots": 1,
      "bind_group_layout_ids": [100]
    },
    {
      "cmd": "CreateBuffer",
      "id": 11,
      "label": "vertex_buffer",
      "size": 36,
      "usage": ["VERTEX", "COPY_DST"]
    },
    {
      "cmd": "WriteBuffer",
      "buffer_id": 11,
      "offset": 0,
      "size": 36,
      "data": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    },
    {
      "cmd": "CreateBuffer",
      "id": 12,
      "label": "uniform_buffer",
      "size": 16,
      "usage": ["UNIFORM", "COPY_DST"]
    },
    {
      "cmd": "WriteBuffer",
      "buffer_id": 12,
      "offset": 0,
      "size": 16,
      "data": "AAAAAAAAAAAAAAAAAAAAAA=="
    },
    {
      "cmd": "CreateBindGroup",
      "id": 13,
      "label": "panel_bind_group",
      "bind_group_layout_id": 100,
      "entries": [
        {
          "binding": 0,
          "binding_type": "uniform_buffer",
          "resource_kind": "buffer",
          "resource_id": 12,
          "offset": 0,
          "size": 16
        }
      ]
    },
    {
      "cmd": "CreateTexture",
      "id": 1,
      "label": "render_target",
      "dimension": "2d",
      "width": 4,
      "height": 4,
      "depth": 1,
      "format": "rgba8unorm",
      "usage": ["RENDER_ATTACHMENT"],
      "mip_level_count": 1,
      "sample_count": 1
    },
    {
      "cmd": "BeginCommandEncoder",
      "id": 20
    },
    {
      "cmd": "BeginRenderPass",
      "id": 21,
      "encoder_id": 20,
      "color_attachments": [
        {
          "texture_id": 1,
          "load_op": "clear",
          "store_op": "store",
          "clear_value": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 1.0 }
        }
      ]
    },
    {
      "cmd": "SetPipeline",
      "pass_id": 21,
      "pipeline_id": 10
    },
    {
      "cmd": "SetVertexBuffer",
      "pass_id": 21,
      "slot": 0,
      "buffer_id": 11,
      "offset": 0
    },
    {
      "cmd": "SetBindGroup",
      "pass_id": 21,
      "slot": 0,
      "bind_group_id": 13
    },
    {
      "cmd": "Draw",
      "pass_id": 21,
      "vertex_count": 3,
      "instance_count": 1,
      "first_vertex": 0,
      "first_instance": 0
    },
    {
      "cmd": "EndRenderPass",
      "pass_id": 21
    },
    {
      "cmd": "FinishCommandEncoder",
      "encoder_id": 20,
      "command_buffer_id": 22
    },
    {
      "cmd": "QueueSubmit",
      "command_buffer_ids": [22],
      "submission_id": 30
    }
  ],
  "expected": {
    "outcome": "success"
  }
}
