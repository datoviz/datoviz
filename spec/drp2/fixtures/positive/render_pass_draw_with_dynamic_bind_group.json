{
  "name": "render_pass_draw_with_dynamic_bind_group",
  "description": "Begins a render pass, binds a render pipeline and a bind group with dynamic buffer offsets, records one draw, ends the pass, and finishes the encoder.",
  "reason": "Dynamic buffer bindings are declared by the bind-group layout and SetBindGroup supplies one offset per dynamic binding in layout order.",
  "notes": "The resulting buffer ranges remain in bounds after adding the dynamic offsets to the bind-group entry base offsets.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "positive",
    "render_pass",
    "bind_group",
    "dynamic_offsets",
    "draw"
  ],
