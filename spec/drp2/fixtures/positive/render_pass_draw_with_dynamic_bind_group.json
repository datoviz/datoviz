      ]
    },
    {
      "cmd": "CreateBuffer",
      "id": 15,
      "size": 768,
      "usage": [
        "STORAGE"
      ]
    },
    {
      "cmd": "CreateBindGroup",
      "id": 13,
      "bind_group_layout_id": 14,
      "entries": [
        {
          "binding": 0,
          "binding_type": "uniform_buffer",
          "resource_kind": "buffer",
          "resource_id": 12,
          "offset": 0,
          "size": 16
        },
        {
          "binding": 1,
