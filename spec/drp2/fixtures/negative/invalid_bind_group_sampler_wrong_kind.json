      "cmd": "HelloRenderer",
      "version": { "major": 2, "minor": 0 },
      "client_name": "fixture-client"
    },
    {
      "cmd": "RendererHelloReply",
      "version": { "major": 2, "minor": 0 },
      "status": "ok",
      "renderer_name": "fixture-renderer"
    },
    {
      "cmd": "CreateTexture",
      "id": 1,
      "dimension": "2d",
      "width": 2,
      "height": 2,
      "depth": 1,
      "format": "rgba8unorm",
      "usage": ["TEXTURE_BINDING", "COPY_DST"],
      "mip_level_count": 1,
      "sample_count": 1
    },
    {
      "cmd": "CreateBindGroupLayout",
      "id": 100,
      "entries": [
        { "binding": 0, "binding_type": "sampler" }
      ]
    },
    {
      "cmd": "CreateBindGroup",
      "id": 13,
      "bind_group_layout_id": 100,
      "entries": [
        {
          "binding": 0,
          "binding_type": "sampler",
          "resource_kind": "texture",
          "resource_id": 1
        }
      ]
    }
  ],
