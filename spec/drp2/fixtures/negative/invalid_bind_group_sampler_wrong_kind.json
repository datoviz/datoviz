{
  "name": "invalid_bind_group_sampler_wrong_kind",
  "description": "Create a bind group with a sampler binding_type but supply a texture as the resource.",
  "reason": "The layout declares binding 0 as a sampler. The bind group supplies resource_kind=texture for that slot. The schema allOf constraint requires resource_kind=sampler for a sampler binding_type, so this fails at schema validation.",
  "fix": "Use resource_kind=sampler and supply a live sampler id for a sampler binding.",
  "version": {
    "major": 2,
    "minor": 0
  },
  "tags": [
    "negative",
    "sampler",
    "bind_group",
    "type_mismatch"
  ],
