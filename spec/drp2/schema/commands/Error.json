{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "Error"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "severity",
    "message"
  ]
}