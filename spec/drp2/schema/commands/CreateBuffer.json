{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateBuffer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "CreateBuffer"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "type": "array",
      "items": {
        "$ref": "../common/GPUBufferUsage.json"
      },
      "minItems": 1
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "size",
    "usage"
  ]
}
