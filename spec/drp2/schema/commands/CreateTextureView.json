{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateTextureView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "CreateTextureView"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "texture": {
      "$ref": "../common/Id.json"
    },
    "format": {
      "$ref": "../common/GPUTextureFormat.json"
    },
    "dimension": {
      "$ref": "../common/TextureViewDimension.json"
    },
    "aspect": {
      "$ref": "../common/TextureAspect.json"
    },
    "mipRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "count"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "layerRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "count"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "type",
    "id",
    "texture",
    "format",
    "dimension",
    "aspect",
    "mipRange",
    "layerRange"
  ]
}