{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WriteTexture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "WriteTexture"
    },
    "texture_id": {
      "$ref": "../common/Id.json"
    },
    "mip_level": {
      "type": "integer",
      "minimum": 0
    },
    "origin": {
      "$ref": "../common/Origin3D.json"
    },
    "size": {
      "$ref": "../common/Extent3D.json"
    },
    "bytes_per_row": {
      "type": "integer",
      "minimum": 0
    },
    "rows_per_image": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64"
    }
  },
  "required": [
    "cmd",
    "texture_id",
    "mip_level",
    "origin",
    "size",
    "bytes_per_row",
    "rows_per_image",
    "data"
  ]
}
