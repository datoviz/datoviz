{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceBarrier",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "ResourceBarrier"
    },
    "encoder_id": {
      "$ref": "../common/Id.json"
    },
    "buffer_id": {
      "$ref": "../common/Id.json"
    },
    "src_stage": {
      "enum": ["COMPUTE"]
    },
    "src_access": {
      "enum": ["STORAGE_WRITE"]
    },
    "dst_stage": {
      "enum": ["VERTEX_INPUT", "COPY"]
    },
    "dst_access": {
      "enum": ["VERTEX_READ", "COPY_READ"]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [
    "cmd",
    "encoder_id",
    "buffer_id",
    "src_stage",
    "src_access",
    "dst_stage",
    "dst_access"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "dst_stage": { "const": "VERTEX_INPUT" } },
        "required": ["dst_stage"]
      },
      "then": {
        "properties": { "dst_access": { "const": "VERTEX_READ" } }
      }
    },
    {
      "if": {
        "properties": { "dst_stage": { "const": "COPY" } },
        "required": ["dst_stage"]
      },
      "then": {
        "properties": { "dst_access": { "const": "COPY_READ" } }
      }
    }
  ]
}
