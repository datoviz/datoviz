{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeginRenderPass",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "BeginRenderPass"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "encoder_id": {
      "$ref": "../common/Id.json"
    },
    "color_attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "texture_id": {
            "$ref": "../common/Id.json"
          },
          "resolve_target_texture_id": {
            "$ref": "../common/Id.json"
          },
          "load_op": {
            "$ref": "../common/LoadOp.json"
          },
          "store_op": {
            "$ref": "../common/StoreOp.json"
          },
          "clear_value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "r": {
                "type": "number"
              },
              "g": {
                "type": "number"
              },
              "b": {
                "type": "number"
              },
              "a": {
                "type": "number"
              }
            },
            "required": [
              "r",
              "g",
              "b",
              "a"
            ]
          }
        },
        "required": [
          "texture_id",
          "load_op",
          "store_op"
        ]
      }
    },
    "render_area": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "min_depth": {
          "type": "number"
        },
        "max_depth": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "scissor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "depth_stencil_attachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "texture_id": {
          "$ref": "../common/Id.json"
        },
        "depth_load_op": {
          "$ref": "../common/LoadOp.json"
        },
        "depth_store_op": {
          "$ref": "../common/StoreOp.json"
        },
        "depth_clear_value": {
          "type": "number"
        },
        "stencil_load_op": {
          "$ref": "../common/LoadOp.json"
        },
        "stencil_store_op": {
          "$ref": "../common/StoreOp.json"
        },
        "stencil_clear_value": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "texture_id"
      ]
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "encoder_id",
    "color_attachments"
  ]
}
