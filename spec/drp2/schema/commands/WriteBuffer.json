{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WriteBuffer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "WriteBuffer"
    },
    "buffer_id": {
      "$ref": "../common/Id.json"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Raw bytes encoded as base64."
    }
  },
  "required": [
    "cmd",
    "buffer_id",
    "offset",
    "size",
    "data"
  ]
}
