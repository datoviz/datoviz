{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateRenderPipeline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "CreateRenderPipeline"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "vertex_shader_module_id": {
      "$ref": "../common/Id.json"
    },
    "fragment_shader_module_id": {
      "$ref": "../common/Id.json"
    },
    "vertex_buffer_slots": {
      "type": "integer",
      "minimum": 0
    },
    "bind_group_layout_ids": {
      "type": "array",
      "items": {
        "$ref": "../common/Id.json"
      }
    },
    "vertex_buffers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["array_stride", "attributes"],
        "properties": {
          "array_stride": {
            "type": "integer",
            "minimum": 0
          },
          "step_mode": {
            "type": "string",
            "enum": ["vertex", "instance"]
          },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "offset", "shader_location"],
              "properties": {
                "format": {
                  "$ref": "../common/GPUVertexFormat.json"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "shader_location": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "topology": {
      "$ref": "../common/PrimitiveTopology.json"
    },
    "cull_mode": {
      "$ref": "../common/CullMode.json"
    },
    "front_face": {
      "$ref": "../common/FrontFace.json"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "multisample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "alpha_to_coverage_enabled"],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "alpha_to_coverage_enabled": {
          "type": "boolean"
        }
      }
    },
    "depth_stencil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "$ref": "../common/GPUTextureFormat.json"
        },
        "depth_write_enabled": {
          "type": "boolean"
        },
        "depth_compare": {
          "$ref": "../common/CompareFunction.json"
        },
        "stencil_front": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compare":       { "$ref": "../common/CompareFunction.json" },
            "fail_op":       { "$ref": "../common/StencilOperation.json" },
            "depth_fail_op": { "$ref": "../common/StencilOperation.json" },
            "pass_op":       { "$ref": "../common/StencilOperation.json" }
          }
        },
        "stencil_back": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compare":       { "$ref": "../common/CompareFunction.json" },
            "fail_op":       { "$ref": "../common/StencilOperation.json" },
            "depth_fail_op": { "$ref": "../common/StencilOperation.json" },
            "pass_op":       { "$ref": "../common/StencilOperation.json" }
          }
        }
      }
    },
    "color_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format"],
        "properties": {
          "format": {
            "$ref": "../common/GPUTextureFormat.json"
          },
          "blend": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "alpha"],
            "properties": {
              "color": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src_factor", "dst_factor", "operation"],
                "properties": {
                  "src_factor":  { "$ref": "../common/BlendFactor.json" },
                  "dst_factor":  { "$ref": "../common/BlendFactor.json" },
                  "operation":   { "$ref": "../common/BlendOperation.json" }
                }
              },
              "alpha": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src_factor", "dst_factor", "operation"],
                "properties": {
                  "src_factor":  { "$ref": "../common/BlendFactor.json" },
                  "dst_factor":  { "$ref": "../common/BlendFactor.json" },
                  "operation":   { "$ref": "../common/BlendOperation.json" }
                }
              }
            }
          },
          "write_mask": {
            "$ref": "../common/ColorWriteMask.json"
          }
        }
      }
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "vertex_shader_module_id",
    "fragment_shader_module_id",
    "vertex_buffer_slots"
  ]
}
