{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HelloRenderer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "HelloRenderer"
    },
    "version": {
      "$ref": "../common/Version.json"
    },
    "client_name": {
      "type": "string"
    },
    "requested_features": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    }
  },
  "required": [
    "cmd",
    "version"
  ]
}
