{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draw",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "Draw"
    },
    "pass_id": {
      "$ref": "../common/Id.json"
    },
    "vertex_count": {
      "type": "integer",
      "minimum": 0
    },
    "instance_count": {
      "type": "integer",
      "minimum": 0
    },
    "first_vertex": {
      "type": "integer",
      "minimum": 0
    },
    "first_instance": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "cmd",
    "pass_id",
    "vertex_count",
    "instance_count",
    "first_vertex",
    "first_instance"
  ]
}
