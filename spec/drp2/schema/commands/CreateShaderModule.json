{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateShaderModule",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "CreateShaderModule"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "stage": {
      "$ref": "../common/ShaderModuleStage.json"
    },
    "format": {
      "$ref": "../common/ShaderFormat.json"
    },
    "entry_point": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "description": "WGSL/GLSL source text or base64-encoded SPIR-V bytes, depending on format."
    },
    "required_features": {
      "type": "array",
      "items": {
        "$ref": "../common/RequiredFeature.json"
      },
      "uniqueItems": true
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "stage",
    "format",
    "entry_point",
    "code"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "spirv"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        }
      }
    }
  ]
}
