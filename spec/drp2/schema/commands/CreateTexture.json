{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateTexture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "CreateTexture"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "dimension": {
      "$ref": "../common/TextureDimension.json"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "$ref": "../common/GPUTextureFormat.json"
    },
    "usage": {
      "type": "array",
      "items": {
        "$ref": "../common/GPUTextureUsage.json"
      },
      "minItems": 1
    },
    "mip_level_count": {
      "type": "integer",
      "minimum": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "color_role": {
      "$ref": "../common/TextureColorRole.json"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "dimension",
    "width",
    "height",
    "depth",
    "format",
    "usage",
    "mip_level_count",
    "sample_count"
  ]
}
