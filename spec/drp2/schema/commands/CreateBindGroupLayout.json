{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateBindGroupLayout",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "CreateBindGroupLayout"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding": {
            "type": "integer",
            "minimum": 0
          },
          "binding_type": {
            "type": "string",
            "enum": [
              "uniform_buffer",
              "storage_buffer",
              "sampled_texture",
              "storage_texture",
              "sampler"
            ]
          },
          "has_dynamic_offset": {
            "type": "boolean"
          },
          "visibility": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "../common/ShaderStage.json"
            }
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "read_write"
            ]
          }
        },
        "required": [
          "binding",
          "binding_type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "has_dynamic_offset": {
                  "const": true
                }
              },
              "required": [
                "has_dynamic_offset"
              ]
            },
            "then": {
              "properties": {
                "binding_type": {
                  "enum": [
                    "uniform_buffer",
                    "storage_buffer"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "entries"
  ]
}
