{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QueueSubmit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "QueueSubmit"
    },
    "command_buffer_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common/Id.json"
      }
    },
    "submission_id": {
      "$ref": "../common/Id.json"
    },
    "readbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "buffer_id": { "$ref": "../common/Id.json" },
          "offset": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1 }
        },
        "required": ["buffer_id", "offset", "size"]
      }
    }
  },
  "required": [
    "cmd",
    "command_buffer_ids"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "readbacks": { "type": "array", "minItems": 1 } },
        "required": ["readbacks"]
      },
      "then": {
        "required": ["submission_id"]
      }
    }
  ]
}
