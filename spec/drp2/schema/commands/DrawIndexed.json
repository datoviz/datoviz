{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrawIndexed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "DrawIndexed"
    },
    "pass": {
      "$ref": "../common/Id.json.json"
    },
    "indexCount": {
      "type": "integer",
      "minimum": 0
    },
    "instanceCount": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "firstIndex": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "baseVertex": {
      "type": "integer",
      "default": 0
    },
    "firstInstance": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [
    "type",
    "pass",
    "indexCount"
  ]
}