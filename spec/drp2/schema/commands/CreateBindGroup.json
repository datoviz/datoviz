{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateBindGroup",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cmd": {
      "const": "CreateBindGroup"
    },
    "id": {
      "$ref": "../common/Id.json"
    },
    "bind_group_layout_id": {
      "$ref": "../common/Id.json"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding": {
            "type": "integer",
            "minimum": 0
          },
          "binding_type": {
            "type": "string",
            "enum": [
              "uniform_buffer",
              "storage_buffer",
              "sampled_texture",
              "storage_texture"
            ]
          },
          "resource_kind": {
            "type": "string",
            "enum": [
              "buffer",
              "texture"
            ]
          },
          "resource_id": {
            "$ref": "../common/Id.json"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "binding",
          "binding_type",
          "resource_kind",
          "resource_id"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "binding_type": {
                  "enum": [
                    "uniform_buffer",
                    "storage_buffer"
                  ]
                }
              },
              "required": [
                "binding_type"
              ]
            },
            "then": {
              "properties": {
                "resource_kind": {
                  "enum": [
                    "buffer",
                    "texture"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "cmd",
    "id",
    "bind_group_layout_id",
    "entries"
  ]
}
