{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "major": {
      "type": "integer",
      "minimum": 0
    },
    "minor": {
      "type": "integer",
      "minimum": 0
    },
    "patch": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "major",
    "minor"
  ]
}
