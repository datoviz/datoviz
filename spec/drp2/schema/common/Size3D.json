{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Size3D",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "depthOrArrayLayers"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "depthOrArrayLayers": {
      "type": "integer",
      "minimum": 1
    }
  }
}